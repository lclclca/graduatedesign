sample(sample) ::= <<<sample:{sampleInfo|
<if(sampleInfo.direction)>
GET_SAMPLING_PORT_ID("<sampleInfo.portName>", &(<sampleInfo.id>), &(ret));
CHECK_CODE("GET_SAMPLING_PORT_ID(<sampleInfo.portName>)", ret);
  
READ_SAMPLING_MESSAGE (<sampleInfo.id>, <sampleInfo.messageAddr>, &(<sampleInfo.length>), &(<sampleInfo.validityType>), &(ret));
CHECK_VALIDCODE("READ_SAMPLING_MESSAGE(<sampleInfo.id>)", <sampleInfo.validityType>, ret);
CHECK_CODE("READ_SAMPLING_MESSAGE(<sampleInfo.id>)", ret);
<else>
GET_SAMPLING_PORT_ID("<sampleInfo.portName>", &(<sampleInfo.id>), &(ret));
CHECK_CODE("GET_SAMPLING_PORT_ID(<sampleInfo.portName>)", ret);

WRITE_SAMPLING_MESSAGE(<sampleInfo.id>, <sampleInfo.messageAddr>, sizeof (<sampleInfo.dataType>), &(ret));
CHECK_CODE("WRITE_SAMPLING_MESSAGE(<sampleInfo.id>)", ret);
<endif>}; separator="\n">
>>

