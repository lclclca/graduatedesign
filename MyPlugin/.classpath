<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="src" path="src"/>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER">
		<attributes>
			<attribute name="module" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="con" path="org.eclipse.pde.core.requiredPlugins"/>
	<classpathentry kind="lib" path="lib/choco-solver-4.10.8.jar"/>
	<classpathentry kind="lib" path="lib/choco-solver-4.10.8-jar-with-dependencies.jar"/>
	<classpathentry kind="lib" path="lib/dom4j-1.6.1.jar"/>
	<classpathentry kind="lib" path="lib/ejml-0.25.jar"/>
	<classpathentry kind="lib" path="lib/beautyeye_lnf.jar"/>
	<classpathentry kind="output" path="bin"/>
</classpath>
