package DIMA_threads
public
	
	with CH_Properties;
	with ARINC653;
	with Base_Types;
	with DIMA_datatype;
	with subprograms;
	
	thread Tsk11
		features
			--分区间采样通信
			task1sampling: out data port Base_Types::Integer;
			
			--分区内 BLACKBOARD with task2
			task1_acc1_out: out data port Base_Types::Integer;
			task1_acc2_out: out data port Base_Types::Integer;
			--分区内 Buffer with task2
			task1_sensor_in: in event data port Base_Types::Integer;
	end Tsk11;

	thread implementation Tsk11.impl
		calls
			Mycalls: {
				receive_spg: subprogram subprograms::commandboard_receiveinput_spg;
				print_spg: subprogram subprograms::commandboard_printinfos_spg;
			};
		properties
			Dispatch_Protocol => Periodic;
			Deadline => 25ms;
			Period => 25ms;
			CH_Properties::Dispatch_Absolute_Time => 2ms;
			CH_Properties::Execution_Time => 1.3ms;
			Priority => 2;
			Stack_Size => 8Kbyte;
			ARINC653::Time_Capacity => 25ms;
			ARINC653::Deadline_Type => soft;
	end Tsk11.impl;

	thread Tsk12
		features
			--分区内 BLACKBOARD with task1
			task2_acc1_in: in data port Base_Types::Integer;
			task2_acc2_in: in data port Base_Types::Integer;
			--分区内 Buffer with task1
			task2_sensor_out: out event data port Base_Types::Integer;
			-- 分区内 BlackBoard with task3
			-- 写消息
			task2_printer: requires data access DIMA_datatype::protected_data {ARINC653::Queueing_Discipline => FIFO;
				Access_Right => write_only;
			};

	end Tsk12;

	thread implementation Tsk12.impl
		properties
			Dispatch_Protocol => Periodic;
			Deadline => 50ms;
			Period => 50ms;
			CH_Properties::Dispatch_Absolute_Time => 3ms;
			CH_Properties::Execution_Time => 0.4ms;
			Priority => 3;
			Stack_Size => 8Kbyte;
			ARINC653::Time_Capacity => 50ms;
			ARINC653::Deadline_Type => soft;
	end Tsk12.impl;

	thread Tsk13
		features
			-- with task2 BlackBoard
			-- 读消息
			task3_receiver: requires data access DIMA_datatype::protected_data {ARINC653::Queueing_Discipline => FIFO;
				Access_Right => read_only;
			};
			-- with task4 Buffer
			task3_buffer_send: out event data port Base_Types::Integer;
			task3_buffer_receive: in event data port Base_Types::Integer;
			-- with task4 BlackBoard
			task3_blackboard_read: in event data port Base_Types::Integer;
			task3_blackboard_write: out event data port Base_Types::Integer;
	end Tsk13;

	thread implementation Tsk13.impl
		calls
			Mycalls: {
				receive_spg: subprogram subprograms::commandboard_receiveinput_spg;
				
			};
		properties
			Dispatch_Protocol => Periodic;
			Deadline => 50ms;
			Period => 50ms;
			CH_Properties::Dispatch_Absolute_Time => 3ms;
			CH_Properties::Execution_Time => 4.2ms;
			Priority => 4;
			Stack_Size => 8Kbyte;
			ARINC653::Time_Capacity => 50ms;
			ARINC653::Deadline_Type => soft;
	end Tsk13.impl;

	thread Tsk14
		features
			-- with task3 Buffer
			task4_buffer_send: out event data port Base_Types::Integer;
			task4_buffer_receive: in event data port Base_Types::Integer;
			-- with task3 BlackBoard
			task4_blackboard_read: in event data port Base_Types::Integer;
			task4_blackboard_write: out event data port Base_Types::Integer;
			--分区间队列通信
			task4Queuing: in event data port Base_Types::Integer;

	end Tsk14;

	thread implementation Tsk14.impl
		calls
			Mycalls: {
				calculate_spg: subprogram subprograms::calculate_spg;
			};
		connections
			C1: parameter task4_blackboard_read -> calculate_spg.data_in;
			C2: parameter calculate_spg.data_out -> task4_blackboard_write;
		properties
			Dispatch_Protocol => Periodic;
			Deadline => 50ms;
			Period => 50ms;
			CH_Properties::Dispatch_Absolute_Time => 0ms;
			CH_Properties::Execution_Time => 0.2ms;
			Priority => 5;
			Stack_Size => 8Kbyte;
			ARINC653::Time_Capacity => 50ms;
			ARINC653::Deadline_Type => soft;
	end Tsk14.impl;
	
	
	thread Tsk21
		features
			task21sampling : in data port Base_Types::Integer;
			--分区内 BLACKBOARD with task2
			task1_acc3_out: out data port Base_Types::Integer;
			--分区内 Buffer with task2
			task1_order_in: in event data port Base_Types::Integer;
	end Tsk21;

	thread implementation Tsk21.impl
		calls
			Mycalls: {
				receive_spg: subprogram subprograms::commandboard_receiveinput_spg;
				print_spg: subprogram subprograms::commandboard_printinfos_spg;
			};
		properties
			Dispatch_Protocol => Periodic;
			Deadline => 50ms;
			Period => 50ms;
			CH_Properties::Dispatch_Absolute_Time => 0ms;
			CH_Properties::Execution_Time => 3.0ms;
			Priority => 2;
			Stack_Size => 8Kbyte;
			ARINC653::Time_Capacity => 50ms;
			ARINC653::Deadline_Type => soft;
	end Tsk21.impl;

	thread Tsk22
