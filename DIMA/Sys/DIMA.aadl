package DIMA
public
	with DIMA_models;
	with FC;


	system DIMAsystem
	end DIMAsystem;

	system implementation DIMAsystem.impl
		subcomponents
			es1: system DIMA_models::M1.impl;
			es2: system DIMA_models::M2.impl;
			es3: system DIMA_models::M3.impl;
			Switch1: bus FC::FibreChannel.i;
			Switch2: bus FC::FibreChannel.i;
		connections
			DIMAsystem_impl_new_connection1: bus access Switch1 -> es1.FC;
			DIMAsystem_impl_new_connection2: bus access Switch1.SW -> Switch2;
			DIMAsystem_impl_new_connection3: bus access Switch2 -> es2.FC;
			DIMAsystem_impl_new_connection4: bus access Switch1 -> es3.FC;
			DIMAsystem_impl_new_connection5: bus access Switch2.SW -> Switch1;
			DIMAsystem_impl_new_connection6: port es1.v1_out -> es2.v1_in;
			DIMAsystem_impl_new_connection7: port es1.v1_out -> es3.V1_in;
			DIMAsystem_impl_new_connection8: port es2.v4_out -> es3.V4_in;
			DIMAsystem_impl_new_connection9: port es3.V3_out -> es2.v3_in;
		properties
			Actual_Connection_Binding => (reference (Switch1)) applies to DIMAsystem_impl_new_connection6;
			Actual_Connection_Binding => (reference (Switch1)) applies to DIMAsystem_impl_new_connection7;
			Actual_Connection_Binding => (reference (Switch2)) applies to DIMAsystem_impl_new_connection8;
			Actual_Connection_Binding => (reference (Switch2)) applies to DIMAsystem_impl_new_connection9;
end DIMAsystem.impl;

end DIMA;