--  This property set is an updated version of the ARINC653 property set.
--  It has been prepared as part of the preparation of AS5506/5 document.

property set ARINC653_as5506_5 is

	---	
	---  The Module_Major_Frame property specifies the major frame for the ARINC653 module
	---	 主时间框架（处理器组件）
	Module_Major_Frame: Time applies to (system, processor, virtual processor);

	---
	---  The Sampling_Refresh_Period property indicates data arrival rate for an in data port. It
	---  corresponds to the concept of refresh time of ARINC653 sampling port.
	---  采样端口刷新周期
	Sampling_Refresh_Period: Time applies to (data port);

	---
	---  The Supported_Error_Code enumeration corresponds to the possible Error code that can be raised at
	---  the different levels of ARINC653 architecture (module, partition, process). The list of possible values may
	---  be extended by a given implementation.
	---  枚举类型，对应于可能在ARINC653体系结构的不同级别（模块、分区、进程）引发的错误代码
	---  可能值的列表可以通过给定的实现进行扩展。
	Supported_Error_Code: type enumeration (Module_Config, Module_Init, Module_Scheduling, Partition_Scheduling,
		Partition_Config, Partition_Handler, Partition_Init, Deadline_Miss, Application_Error, Numeric_Error,
		Illegal_Request, Stack_Overflow, Memory_Violation, Hardware_Fault, Power_Fail);

	---
	---  The Supported_Memory_Kind enumeration describes possible content of an AADL memory component.
	---  枚举类型，描述AADL内存组件的可能内容
	Supported_Memory_Kind: type enumeration (Memory_Data, Memory_Code);

	---
	---  The Memory_Kind property describes the content of an AADL memory component.
	---	 描述AADL内存组件的内容
	Memory_Kind: list of ARINC653_as5506_5::Supported_Memory_Kind applies to (memory);

	---
	---  The Timeout property specifies the timeout used by an ARINC653 process when sending/receiving a
	---  data. Depending on which component is used, the property value could be useful for sender or receiver side.
	---  进程发送/接受数据超时
	Timeout: Time applies to (port, access connection);

	---
	---  The Supported_Criticality_Type enumeration corresponds to the different Development
	---  Assurance Levels supported by the ARINC653 standard.
	---  枚举类型，对应于ARINC653标准支持的不同开发保证级别
	Supported_DAL_Type: type enumeration (LEVEL_A, LEVEL_B, LEVEL_C, LEVEL_D, LEVEL_E);

	---  
	---  The Criticality property defines the Design Assurance Level of a partition. It is associated to the
	---  runtime of each partition (an AADL virtual processor component).
	---  定义了分区的设计保证级别。它与每个分区（一个AADL虚拟处理器组件）的运行时相关联
	DAL: ARINC653_as5506_5::Supported_DAL_Type applies to (virtual processor, process, thread, subprogram);

	---
	---  Module version description.
	---  模块版本
	Module_Version: aadlstring applies to (system, processor);

	---
	---  Module unique identifier.
	---  模块唯一标识符
	Module_Identifier: aadlstring applies to (system, processor);

	---
	---  Partition identifier unique within the module.
	---	 分区标识符，在模块中唯一
	Partition_Identifier: aadlinteger applies to (virtual processor);

	---
	---  Name of a partition name, should be unique within the module.
	---  分区命名，在模块中唯一
	Partition_Name: aadlstring applies to (virtual processor);

	---
	---  When set to true, this property indicates the partition is a system one.
	---  设置为true表示该分区为系统分区
	System_Partition: aadlboolean applies to (virtual processor);

	---
	---  Specify the thread/ARINC653 process dedicated to error/fault management/handling
	---  指定用于错误/故障管理/处理的线程/ARINC653进程
	Error_Handling: reference (thread) applies to (virtual processor);

	---	
	---  The Error_Level_Type property indicates where an error is handled:
	---	 指示处理错误的位置
	Error_Level_Type: type enumeration (Module_Level, Partition_Level, Process_Level);

	---
	---  The HM_Error_ID_Level_Type indicates where each error is supposed
	---  to be raised (which layer) and associate an error identifier.
	---	 指示每个错误应该在哪里引发（哪一层）并关联一个错误标识符
	HM_Error_ID_Level_Type: type record (
		ErrorIdentifier: aadlinteger;
		Description: aadlstring;
		ErrorLevel: ARINC653_as5506_5::Error_Level_Type;
		ErrorCode: ARINC653_as5506_5::Supported_Error_Code;
	);

	---
	---  The HM_Error_ID_Levels indicates will the faults in a module
	---  with their associated level.
	---  指示模块中的故障及其相关级别
	HM_Error_ID_Levels: list of ARINC653_as5506_5::HM_Error_ID_Level_Type applies to (processor);

	---
	---  The HM_Error_ID_Action_Type specifies an action
	---  for a specific error type/id.
	---  指定特定错误类型/ID的操作
	HM_Error_ID_Action_Type: type record (
		ErrorIdentifier: aadlinteger;
		Description: aadlstring;
		Action: aadlstring;
	);

	---
	---  The HM_Error_ID_Actions specifies the error recovery handler
	---  at each layer.
	---  指定每层的错误恢复处理程序
	HM_Error_ID_Actions: list of ARINC653_as5506_5::HM_Error_ID_Action_Type applies to (processor, virtual processor,
		thread);

	---
	---  Type for gathering information related to
	---  an ARINC653 state. Then, it is associated
	---  with an AADL mode.
	---  用于收集ARINC653状态相关信息的类型
	---	 与AADL模式相关联
	State_Information_Type: type record (
		Identifier: aadlinteger;
		Description: aadlstring;
	);

	---
	---  Association of a ARINC653 state information to the AADL mode.
	---  ARINC653状态信息与AADL模式的关联
	State_Information: ARINC653_as5506_5::State_Information_Type applies to (mode);

	---
	---  The Queueing discipline type reflects how a task
	---  can be dispatched when a new element is available
	---  on an event port or event data port.
	---  反映了当事件端口或事件数据端口上有新元素可用时如何调度任务
	Queueing_Discipline_Type: type enumeration (Fifo, By_Priority);

	---
	---  This property reflects the Queueing_Discipline_Type
	---  on port.
	---  反映端口的Queueing_Discipline_Type
	Queueing_Discipline: ARINC653_as5506_5::Queueing_Discipline_Type applies to (port, data access);

	---
	---  The Schedule_Window type represents a record to specify a time
	---  slot/frame associated to a partition
	---  记录类型，用于指定与分区关联的时隙/帧
	Schedule_Window: type record (
		Partition: reference (virtual processor, processor);
		Duration: time;
		Periodic_Processing_Start: aadlboolean;);

	---
	---  Module_Schedule represents all the schedule windows for the module
	---  表示模块的所有调度窗口
	Module_Schedule: list of ARINC653_as5506_5::Schedule_Window applies to (system, processor, virtual processor);

	---
	---  Time_Capacity represents the time capacity associated
	---  to an ARINC653 process.
	---  表示与ARINC653进程相关的时间容量
	Time_Capacity: Time applies to (thread);

	---
	---  The Deadline_Type captures the type of a deadline
	---  for a thread/ARINC653 process.
	---  捕获线程/ARINC653进程的截止日期类型
	Deadline_Type: enumeration (soft, hard) applies to (thread);

end ARINC653_as5506_5;