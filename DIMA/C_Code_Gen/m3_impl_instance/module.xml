<?xml version="1.0" encoding="UTF-8"?>
<!-- ARINC 653 Module Configuration File for M3 (arinckernel.module3)     -->
<!-- 对应 AADL: DIMA_models::M3.impl + DIMA_Processor::arinckernel.module3 -->
<!-- 本文件由 ARINC 653 操作系统（ACoreOS653）在启动时读取，               -->
<!-- 用于配置模块内所有分区的资源、调度窗口和健康监控策略。                -->
<ARINC_653_Module xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:noNamespaceSchemaLocation="A653_Part1_revA.xsd"
                  ModuleName="M3_DIMA_Module" ModuleVersion="1.0">

    <!-- ================================================================ -->
    <!-- 分区定义                                                           -->
    <!-- ================================================================ -->

    <!-- ps4 (P4): 处理模块，接收 M1 和 M2 的消息，向 M2 反馈处理结果     -->
    <!-- 对应 AADL: DIMA_partitions::P4.impl                              -->
    <Partition PartitionIdentifier="1" PartitionName="ps4"
               Criticality="LEVEL_A" SystemPartition="true" EntryPoint="entryPoint">
        <!-- order_in:    接收 M1 广播的指令（来自 V1_in 采样端口）        -->
        <Queuing_Port PortName="order_in"    MaxMessageSize="4" Direction="Destination" MaxNbMessages="1"/>
        <!-- queueingout: 向 M2（ps3）发送处理结果（对应 V3_out）           -->
        <Queuing_Port PortName="queueingout" MaxMessageSize="4" Direction="Source"      MaxNbMessages="4"/>
        <!-- queueingin:  接收 M2（ps5）转发的消息（来自 V4_in）            -->
        <Queuing_Port PortName="queueingin"  MaxMessageSize="4" Direction="Destination" MaxNbMessages="4"/>
    </Partition>

    <!-- ================================================================ -->
    <!-- 内存分配                                                           -->
    <!-- 对应 AADL: DIMA_Memory::mainmemory.module3                       -->
    <!-- ================================================================ -->
    <Partition_Memory PartitionIdentifier="1" PartitionName="ps4">
        <Memory_Requirements Type="CODE" SizeBytes="1024" Access="READ_WRITE" PhysicalAddress="0"/>
    </Partition_Memory>

    <!-- ================================================================ -->
    <!-- 模块调度表（Major Frame = 25ms）                                   -->
    <!-- 对应 AADL: arinckernel.module3 Module_Schedule                   -->
    <!-- 窗口布局：[ps4: 0~15ms] [系统分区: 15~25ms]                      -->
    <!-- ps4 分区获得 15ms 时间窗口，满足 task41(25ms)/42(50ms)/43(50ms)   -->
    <!-- 等多个不同周期任务的调度需求                                        -->
    <!-- ================================================================ -->
    <Module_Schedule MajorFrameSeconds="0.025">
        <Partition_Schedule PartitionIdentifier="1" PartitionName="ps4"
                            PeriodSeconds="0.025" PeriodDurationSeconds="0.015">
            <!-- 唯一窗口：0ms 开始，持续 15ms                            -->
            <Window_Schedule WindowIdentifier="101" WindowStartSeconds="0.000"
                             WindowDurationSeconds="0.015" PartitionPeriodStart="true"/>
        </Partition_Schedule>
    </Module_Schedule>

    <!-- ================================================================ -->
    <!-- 通道连接表                                                         -->
    <!-- M3 内只有一个软件分区（ps4），无分区间通道                         -->
    <!-- 跨模块通信（M1→M3，M2→M3，M3→M2）由 FC 总线在系统级实现           -->
    <!-- ================================================================ -->
    <Connection_Table>
        <!-- M3 内无分区间通道；所有通信均跨模块 -->
    </Connection_Table>

    <!-- ================================================================ -->
    <!-- 健康监控表（Health Monitoring）                                    -->
    <!-- 对应 AADL: arinckernel.module3 HM_Error_ID_Levels/Actions        -->
    <!-- ================================================================ -->
    <System_HM_Table>
        <System_State_Entry SystemState="1" Description="Module Init">
            <Error_ID_Level ErrorIdentifier="1" Description="Module Config Error"      ErrorLevel="MODULE"/>
            <Error_ID_Level ErrorIdentifier="2" Description="Module Init Error"        ErrorLevel="MODULE"/>
            <Error_ID_Level ErrorIdentifier="5" Description="Segmentation Error"       ErrorLevel="MODULE"/>
            <Error_ID_Level ErrorIdentifier="6" Description="Time Duration Exceeded"   ErrorLevel="MODULE"/>
            <Error_ID_Level ErrorIdentifier="7" Description="Invalid OS Call"          ErrorLevel="MODULE"/>
        </System_State_Entry>
        <System_State_Entry SystemState="2" Description="System Function Execution">
            <Error_ID_Level ErrorIdentifier="5" Description="Segmentation Violation"   ErrorLevel="MODULE"/>
            <Error_ID_Level ErrorIdentifier="6" Description="Time Duration Exceeded"   ErrorLevel="MODULE"/>
            <Error_ID_Level ErrorIdentifier="7" Description="Invalid OS Call"          ErrorLevel="MODULE"/>
            <Error_ID_Level ErrorIdentifier="8" Description="Divide by Zero"           ErrorLevel="MODULE"/>
            <Error_ID_Level ErrorIdentifier="9" Description="Floating Point Error"     ErrorLevel="MODULE"/>
        </System_State_Entry>
    </System_HM_Table>

    <Module_HM_Table ModuleCallback="module_HM_callback">
        <System_State_Entry SystemState="1" Description="module init">
            <Error_ID_Action ErrorIdentifier="1" Action="SHUTDOWN"/>
            <Error_ID_Action ErrorIdentifier="2" Action="SHUTDOWN"/>
            <Error_ID_Action ErrorIdentifier="5" Action="SHUTDOWN"/>
            <Error_ID_Action ErrorIdentifier="6" Action="IGNORE"/>
            <Error_ID_Action ErrorIdentifier="7" Action="IGNORE"/>
        </System_State_Entry>
        <System_State_Entry SystemState="2" Description="system function execution">
            <Error_ID_Action ErrorIdentifier="5" Action="SHUTDOWN"/>
            <Error_ID_Action ErrorIdentifier="6" Action="IGNORE"/>
            <Error_ID_Action ErrorIdentifier="7" Action="IGNORE"/>
            <Error_ID_Action ErrorIdentifier="8" Action="IGNORE"/>
            <Error_ID_Action ErrorIdentifier="9" Action="IGNORE"/>
        </System_State_Entry>
    </Module_HM_Table>

    <Partition_HM_Table PartitionIdentifier="1" PartitionName="ps4" PartitionCallback="partition_HM_callback">
        <System_State_Entry SystemState="1" Description="partition init">
            <Error_ID_Action ErrorIdentifier="3" Description="partition config error" Action="IDLE"/>
            <Error_ID_Action ErrorIdentifier="4" Description="partition init error"   Action="COLD_START"/>
            <Error_ID_Action ErrorIdentifier="5" Description="segmentation error"     Action="COLD_START"/>
            <Error_ID_Action ErrorIdentifier="6" Description="time duration exceeded" Action="IGNORE"/>
            <Error_ID_Action ErrorIdentifier="7" Description="invalid OS call"        Action="IGNORE"/>
        </System_State_Entry>
        <System_State_Entry SystemState="2" Description="partition error handler">
            <Error_ID_Action ErrorIdentifier="5" Description="segmentation error"     Action="IDLE"/>
            <Error_ID_Action ErrorIdentifier="6" Description="time duration exceeded" Action="IGNORE"/>
            <Error_ID_Action ErrorIdentifier="7" Description="invalid OS call"        Action="IDLE"/>
            <Error_ID_Action ErrorIdentifier="8" Description="divide by 0"            Action="WARM_START"/>
            <Error_ID_Action ErrorIdentifier="9" Description="overflow"               Action="WARM_START"/>
        </System_State_Entry>
    </Partition_HM_Table>

</ARINC_653_Module>
