package FC
public
	with FC_properties;
	with Base_Types;
	with ARINC653;

	abstract Switch
	end Switch;

	bus anybus
	end anybus;

	bus implementation anybus.i
	end anybus.i;

	bus FibreChannel extends Switch
		features
			SW: requires bus access FibreChannel.i;
	end FibreChannel;

	bus implementation FibreChannel.i
	end FibreChannel.i;

	abstract End_System
		features
			FC: requires bus access FibreChannel.i;
--			FCB: requires bus access FibreChannel;
	end End_System;

	device NetworkControl
	end NetworkControl;

	device NetworkTerminal
		features
			thebus: requires bus access FibreChannel.i;
		properties
			FC_properties::Net_Category => (netcard);
	end NetworkTerminal;

	device implementation NetworkTerminal.impl

	end NetworkTerminal.impl;

